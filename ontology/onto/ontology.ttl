                                                          <https://w3id.org/agentoscin/onto#CoordinationPattern> ;
                                                 rdfs:comment "Coordination pattern in which a selector — typically a model — chooses which agent speaks next at each turn." ;
                                                 rdfs:label "Selector Based" .


###  https://w3id.org/agentoscin/onto#Sequential
<https://w3id.org/agentoscin/onto#Sequential> rdf:type owl:NamedIndividual ,
                                                       <https://w3id.org/agentoscin/onto#CoordinationPattern> ;
                                              rdfs:comment "Coordination pattern in which agents act one after another in a fixed order, each consuming the previous output." ;
                                              rdfs:label "Sequential" .


###  https://w3id.org/agentoscin/onto#Swarm
<https://w3id.org/agentoscin/onto#Swarm> rdf:type owl:NamedIndividual ,
                                                  <https://w3id.org/agentoscin/onto#CoordinationPattern> ;
                                         rdfs:comment "Coordination pattern in which agents hand off control to one another dynamically, based on which agent is best suited to continue." ;
                                         rdfs:label "Swarm" .


#################################################################
#    Annotations
#################################################################

<https://w3id.org/agentoscin/onto#containsAgent> rdfs:comment "Relates an agentic system to an agent it contains." ;
                                                 rdfs:label "contains agent" .


<https://w3id.org/agentoscin/onto#hasAssociatedAgent> rdfs:comment "Links a workflow step to the agent that executes it (e.g. a LangGraph node function implemented by a specific LLMAgent)." ;
                                                      rdfs:label "has associated agent" .


