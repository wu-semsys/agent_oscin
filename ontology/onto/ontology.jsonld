  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A pattern of coordination among agents in a team (e.g. sequential, hierarchical, swarm)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Coordination Pattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Custom",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern that does not match any of the predefined patterns, e.g. a framework-specific or hand-written control flow."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Custom"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#EventBasedTermination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Termination condition that fires when a designated event occurs, e.g. a stop expression appearing in an agent message."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Event Based Termination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Guardrail",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A validation, safety, or policy check applied to a task."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Guardrail"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Hierarchical",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which a manager agent delegates work to subordinate agents and integrates their results."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Hierarchical"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#HumanCheckpoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A human-in-the-loop checkpoint inserted into task execution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Human Checkpoint"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#MemoryBinding",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A reified link between a memory and the agent, team, or system that uses it, with scope and configuration."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Memory Binding"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Network",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which agents communicate peer-to-peer along a graph of connections without a central coordinator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Network"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Orchestration",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A controller that orchestrates one or more teams to execute a workflow."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Orchestration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3id.org/agentic-ai/onto#Team"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#ReAct",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reasoning pattern interleaving reasoning steps with tool calls and observations (Reason + Act)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReAct"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#ReActLoop",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which a single agent cycles between reasoning and tool execution until it produces a final answer."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "ReAct Loop"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A reasoning strategy adopted by an agent (e.g. chain-of-thought, ReAct, tree-of-thoughts)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Reasoning Pattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#ReflectionLoop",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reasoning pattern in which an agent iteratively critiques and revises its own output."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Reflection Loop"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#RoundRobin",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which agents take turns in a fixed cyclic order."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Round Robin"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#RoutingTermination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Termination condition under which execution ends because the routing logic reaches a terminal branch."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Routing Termination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Schema",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A structured-output schema (e.g. JSON Schema, Pydantic model)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Schema"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#SelectorBased",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which a selector — typically a model — chooses which agent speaks next at each turn."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Selector Based"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Sequential",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which agents act one after another in a fixed order, each consuming the previous output."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Sequential"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Swarm",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#CoordinationPattern"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Coordination pattern in which agents hand off control to one another dynamically, based on which agent is best suited to continue."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Swarm"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#TaskCompletionTermination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Termination condition satisfied when the assigned task is completed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Task Completion Termination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A condition under which a team's execution terminates."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Termination Condition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#TreeOfThoughts",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reasoning pattern that explores several alternative reasoning branches and selects among them."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Tree of Thoughts"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#TurnLimitTermination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Termination condition that ends execution once a maximum number of turns is reached."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Turn Limit Termination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#Unspecified",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Placeholder reasoning pattern used when the source system does not state which reasoning strategy an agent follows."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Unspecified"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#agentType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Framework-specific classification of an agent's role in the system. Values: \"GeneralPurpose\", \"UserProxy\", \"Manager\"."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3id.org/agentic-ai/onto#LLMAgent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
