  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Reasoning pattern in which an agent produces explicit intermediate reasoning steps before answering."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Chain of Thought"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#ReasoningPattern"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#CompositeTermination",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A termination condition built by combining other conditions via a logical operator."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Composite Termination"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TerminationCondition"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#ConditionalStep",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A workflow step that branches based on routing logic."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Conditional Step"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3id.org/agentic-ai/onto#WorkflowStep"
  } ]
