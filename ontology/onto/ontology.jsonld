  "@id" : "https://w3id.org/agentoscin/onto#hasMaxTurns",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Maximum number of conversational turns after which execution terminates."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#TurnLimitTermination"
