  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has associated agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3id.org/agentic-ai/onto#LLMAgent"
  } ]
}, {
  "@id" : "https://w3id.org/agentoscin/onto#hasCheckpointPosition",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Point in the execution of a task at which the human checkpoint is applied (e.g. \"AfterExecution\")."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/agentoscin/onto#HumanCheckpoint"
  } ],
