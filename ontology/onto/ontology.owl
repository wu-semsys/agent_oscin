    <!-- https://w3id.org/agentoscin/onto#Custom -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#Custom">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern that does not match any of the predefined patterns, e.g. a framework-specific or hand-written control flow.</rdfs:comment>
        <rdfs:label>Custom</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#Hierarchical -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#Hierarchical">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which a manager agent delegates work to subordinate agents and integrates their results.</rdfs:comment>
        <rdfs:label>Hierarchical</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#Network -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#Network">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which agents communicate peer-to-peer along a graph of connections without a central coordinator.</rdfs:comment>
        <rdfs:label>Network</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#ReActLoop -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#ReActLoop">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which a single agent cycles between reasoning and tool execution until it produces a final answer.</rdfs:comment>
        <rdfs:label>ReAct Loop</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#RoundRobin -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#RoundRobin">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which agents take turns in a fixed cyclic order.</rdfs:comment>
        <rdfs:label>Round Robin</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#SelectorBased -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#SelectorBased">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which a selector — typically a model — chooses which agent speaks next at each turn.</rdfs:comment>
        <rdfs:label>Selector Based</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#Sequential -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#Sequential">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which agents act one after another in a fixed order, each consuming the previous output.</rdfs:comment>
        <rdfs:label>Sequential</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/agentoscin/onto#Swarm -->


    <owl:NamedIndividual rdf:about="https://w3id.org/agentoscin/onto#Swarm">
        <rdf:type rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Coordination pattern in which agents hand off control to one another dynamically, based on which agent is best suited to continue.</rdfs:comment>
        <rdfs:label>Swarm</rdfs:label>
    </owl:NamedIndividual>
    


