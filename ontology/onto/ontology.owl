    <!-- https://w3id.org/agentoscin/onto#AgenticSystem -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#AgenticSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/beam/core#System"/>
        <rdfs:comment>A complete agentic AI system encompassing one or more agents, teams, and an orchestration.</rdfs:comment>
        <rdfs:label>Agentic System</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#ChainOfThought -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#ChainOfThought">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Reasoning pattern in which an agent produces explicit intermediate reasoning steps before answering.</rdfs:comment>
        <rdfs:label>Chain of Thought</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#CompositeTermination -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#CompositeTermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>A termination condition built by combining other conditions via a logical operator.</rdfs:comment>
        <rdfs:label>Composite Termination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#ConditionalStep -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#ConditionalStep">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:comment>A workflow step that branches based on routing logic.</rdfs:comment>
        <rdfs:label>Conditional Step</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#CoordinationPattern -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#CoordinationPattern">
        <rdfs:comment>A pattern of coordination among agents in a team (e.g. sequential, hierarchical, swarm).</rdfs:comment>
        <rdfs:label>Coordination Pattern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#EventBasedTermination -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#EventBasedTermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>Termination condition that fires when a designated event occurs, e.g. a stop expression appearing in an agent message.</rdfs:comment>
        <rdfs:label>Event Based Termination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#Guardrail -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#Guardrail">
        <rdfs:comment>A validation, safety, or policy check applied to a task.</rdfs:comment>
        <rdfs:label>Guardrail</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#HumanCheckpoint -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#HumanCheckpoint">
        <rdfs:comment>A human-in-the-loop checkpoint inserted into task execution.</rdfs:comment>
        <rdfs:label>Human Checkpoint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#MemoryBinding -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#MemoryBinding">
        <rdfs:comment>A reified link between a memory and the agent, team, or system that uses it, with scope and configuration.</rdfs:comment>
        <rdfs:label>Memory Binding</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#Orchestration -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#Orchestration">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:comment>A controller that orchestrates one or more teams to execute a workflow.</rdfs:comment>
        <rdfs:label>Orchestration</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#ReAct -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#ReAct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Reasoning pattern interleaving reasoning steps with tool calls and observations (Reason + Act).</rdfs:comment>
        <rdfs:label>ReAct</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#ReasoningPattern -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#ReasoningPattern">
        <rdfs:comment>A reasoning strategy adopted by an agent (e.g. chain-of-thought, ReAct, tree-of-thoughts).</rdfs:comment>
        <rdfs:label>Reasoning Pattern</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#ReflectionLoop -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#ReflectionLoop">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Reasoning pattern in which an agent iteratively critiques and revises its own output.</rdfs:comment>
        <rdfs:label>Reflection Loop</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#RoutingTermination -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#RoutingTermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>Termination condition under which execution ends because the routing logic reaches a terminal branch.</rdfs:comment>
        <rdfs:label>Routing Termination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#Schema -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#Schema">
        <rdfs:comment>A structured-output schema (e.g. JSON Schema, Pydantic model).</rdfs:comment>
        <rdfs:label>Schema</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#TaskCompletionTermination -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#TaskCompletionTermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>Termination condition satisfied when the assigned task is completed.</rdfs:comment>
        <rdfs:label>Task Completion Termination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#TerminationCondition -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#TerminationCondition">
        <rdfs:comment>A condition under which a team&apos;s execution terminates.</rdfs:comment>
        <rdfs:label>Termination Condition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#TreeOfThoughts -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#TreeOfThoughts">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Reasoning pattern that explores several alternative reasoning branches and selects among them.</rdfs:comment>
        <rdfs:label>Tree of Thoughts</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#TurnLimitTermination -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#TurnLimitTermination">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>Termination condition that ends execution once a maximum number of turns is reached.</rdfs:comment>
        <rdfs:label>Turn Limit Termination</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/agentoscin/onto#Unspecified -->


    <owl:Class rdf:about="https://w3id.org/agentoscin/onto#Unspecified">
        <rdfs:subClassOf rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Placeholder reasoning pattern used when the source system does not state which reasoning strategy an agent follows.</rdfs:comment>
        <rdfs:label>Unspecified</rdfs:label>
    </owl:Class>
    


