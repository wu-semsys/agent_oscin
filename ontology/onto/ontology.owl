<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin#"
     xml:base="http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin">
        <owl:imports rdf:resource="http://www.w3id.org/agentic-ai/onto"/>
        <dc:contributor>Andreas Ekelhart</dc:contributor>
        <dc:contributor>Fajar J. Ekaputra</dc:contributor>
        <dc:creator>Dani Lippmann</dc:creator>
        <dc:description xml:lang="en">An Extension of agentO adding agentic-system orchestration, coordination &amp; reasoning patterns, memory bindings, guardrails, human checkpoints, termination conditions, schemas, and framework-mapping properties.</dc:description>
        <dc:title>AgentOSCIn — Extension of the Agentic AI Ontology</dc:title>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:label>AgentOSCIN Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/elements/1.1/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3id.org/agentic-ai/onto#toolUsage -->


    <owl:ObjectProperty rdf:about="http://www.w3id.org/agentic-ai/onto#toolUsage"/>
    


    <!-- https://w3id.org/agentoscin/onto#bindsMemory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#bindsMemory">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Memory"/>
        <rdfs:comment>Links a memory binding to the memory it binds.</rdfs:comment>
        <rdfs:label>binds memory</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#containsAgent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#containsAgent">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#AgenticSystem"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#containsOrchestration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#containsOrchestration">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#AgenticSystem"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#Orchestration"/>
        <rdfs:comment>Relates an agentic system to its orchestration.</rdfs:comment>
        <rdfs:label>contains orchestration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#containsTeam -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#containsTeam">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#AgenticSystem"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:comment>Relates an agentic system to a team it contains.</rdfs:comment>
        <rdfs:label>contains team</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#dependsOn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#dependsOn">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:comment>Indicates that one task depends on another.</rdfs:comment>
        <rdfs:label>depends on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#employsCoordinationPattern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#employsCoordinationPattern">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#CoordinationPattern"/>
        <rdfs:comment>Relates a team to the coordination pattern it employs.</rdfs:comment>
        <rdfs:label>employs coordination pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#employsReasoningPattern -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#employsReasoningPattern">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#ReasoningPattern"/>
        <rdfs:comment>Relates an agent to the reasoning pattern it employs.</rdfs:comment>
        <rdfs:label>employs reasoning pattern</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasAgentMemoryBinding -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasAgentMemoryBinding">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/agentoscin/onto#hasMemoryBinding"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:comment>Memory binding attached to an individual agent.</rdfs:comment>
        <rdfs:label>has agent memory binding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasAssociatedAgent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasAssociatedAgent">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasGuardrail -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasGuardrail">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#Guardrail"/>
        <rdfs:comment>Associates a guardrail with a task.</rdfs:comment>
        <rdfs:label>has guardrail</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasHumanCheckpoint -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasHumanCheckpoint">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#HumanCheckpoint"/>
        <rdfs:comment>Associates a human-in-the-loop checkpoint with a task.</rdfs:comment>
        <rdfs:label>has human checkpoint</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasMemoryBinding -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasMemoryBinding">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Team"/>
                    <rdf:Description rdf:about="https://w3id.org/agentoscin/onto#AgenticSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:comment>Associates a subject (agent, team, system) with a memory binding.</rdfs:comment>
        <rdfs:label>has memory binding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasOutputSchema -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasOutputSchema">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Task"/>
                    <rdf:Description rdf:about="https://w3id.org/agentoscin/onto#Orchestration"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#Schema"/>
        <rdfs:comment>Specifies the schema of the structured output produced by an orchestration or task.</rdfs:comment>
        <rdfs:label>has output schema</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasSubCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasSubCondition">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#CompositeTermination"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>A sub-condition combined within a composite termination condition.</rdfs:comment>
        <rdfs:label>has sub condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasTeamMemoryBinding -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasTeamMemoryBinding">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/agentoscin/onto#hasMemoryBinding"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:comment>Memory binding attached to a team.</rdfs:comment>
        <rdfs:label>has team memory binding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasTerminationCondition -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#hasTerminationCondition">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:range rdf:resource="https://w3id.org/agentoscin/onto#TerminationCondition"/>
        <rdfs:comment>Relates a team to a termination condition that ends its execution.</rdfs:comment>
        <rdfs:label>has termination condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#memoryBoundTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#memoryBoundTo">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
                    <rdf:Description rdf:about="http://www.w3id.org/agentic-ai/onto#Team"/>
                    <rdf:Description rdf:about="https://w3id.org/agentoscin/onto#AgenticSystem"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Links a memory binding to the agent, team, or system that owns it.</rdfs:comment>
        <rdfs:label>memory bound to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#orchestratesTeam -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#orchestratesTeam">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#Orchestration"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Team"/>
        <rdfs:comment>Relates an orchestration to the team it orchestrates.</rdfs:comment>
        <rdfs:label>orchestrates team</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/agentoscin/onto#taskToolUsage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/agentoscin/onto#taskToolUsage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/agentic-ai/onto#toolUsage"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:comment>A tool used in the execution of a task.</rdfs:comment>
        <rdfs:label>task tool usage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/agentoscin/onto#agentType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#agentType">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Framework-specific classification of an agent&apos;s role in the system. Values: &quot;GeneralPurpose&quot;, &quot;UserProxy&quot;, &quot;Manager&quot;.</rdfs:comment>
        <rdfs:label>agent type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#callsCrew -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#callsCrew">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Key of the team/crew invoked by this workflow step (e.g. CrewAI @listen method calling crew.kickoff()). Enables per-step crew binding through the ontology round-trip.</rdfs:comment>
        <rdfs:label>calls crew</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#containsAgent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#containsAgent">
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasAggregationCombinator -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasAggregationCombinator">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Combinator used to aggregate multiple predecessor steps in the source decorator (e.g. CrewAI @listen(or_(step_a, step_b)) stores &quot;or_&quot;). Values: &quot;or_&quot;, &quot;and_&quot;, or empty for single-predecessor steps.</rdfs:comment>
        <rdfs:label>has aggregation combinator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasAssociatedAgent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasAssociatedAgent">
        <rdfs:range rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasCheckpointPosition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasCheckpointPosition">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#HumanCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Point in the execution of a task at which the human checkpoint is applied (e.g. &quot;AfterExecution&quot;).</rdfs:comment>
        <rdfs:label>has checkpoint position</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasCheckpointType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasCheckpointType">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#HumanCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Kind of human interaction requested at a checkpoint. Values: &quot;Approval&quot;, &quot;Review&quot;, &quot;InputRequest&quot;.</rdfs:comment>
        <rdfs:label>has checkpoint type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasDecoratorArgument -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasDecoratorArgument">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Original literal argument(s) of the framework decorator that defined this step (e.g. CrewAI @start(&quot;wait_next_run&quot;) or @listen(&quot;label&quot;)). Preserves source-level identifiers that are not method names and therefore cannot be reconstructed from the inverse of nextStep edges.</rdfs:comment>
        <rdfs:label>has decorator argument</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasDelegationStrategy -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasDelegationStrategy">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Strategy by which a task may be handed over to another agent instead of being executed by its assigned agent.</rdfs:comment>
        <rdfs:label>has delegation strategy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasDependencyType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasDependencyType">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Nature of the dependency between two tasks. Values: &quot;Sequential&quot; (ordering imposed by the workflow) and &quot;ContextProviding&quot; (the predecessor supplies context to the successor).</rdfs:comment>
        <rdfs:label>has dependency type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasDirectiveFunction -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasDirectiveFunction">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Prompt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Role that a prompt plays for its agent. Values: &quot;ModelDirective&quot; (instructs the underlying model), &quot;OrchestratorDirective&quot; (describes the agent to a coordinating agent), &quot;DualDirective&quot; (serves both purposes).</rdfs:comment>
        <rdfs:label>has directive function</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasEdgeMapping -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasEdgeMapping">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#WorkflowStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>JSON object mapping the return labels of a conditional step to the names of the target steps (e.g. LangGraph add_conditional_edges path map). Preserves branch targets that cannot be reconstructed from nextStep edges alone.</rdfs:comment>
        <rdfs:label>has edge mapping</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasExpectedOutput -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasExpectedOutput">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Natural-language description of the output a task is expected to produce.</rdfs:comment>
        <rdfs:label>has expected output</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasGuardrailType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasGuardrailType">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#Guardrail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>How a guardrail is implemented. Values: &quot;FunctionBased&quot; (a validation callable) and &quot;LLMBased&quot; (a natural-language validation prompt).</rdfs:comment>
        <rdfs:label>has guardrail type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasImplementationReference -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasImplementationReference">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Reference to the implementation of a tool, typically a module path or an &quot;external:&lt;name&gt;&quot; marker for imported tools that were not found in the parsed sources.</rdfs:comment>
        <rdfs:label>has implementation reference</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasInputSchema -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasInputSchema">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Tool"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Serialized JSON Schema describing the arguments accepted by a tool.</rdfs:comment>
        <rdfs:label>has input schema</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasMaxReasoningAttempts -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasMaxReasoningAttempts">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Upper bound on the number of reasoning attempts an agent may perform before giving up.</rdfs:comment>
        <rdfs:label>has max reasoning attempts</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasMaxRetries -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasMaxRetries">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#Guardrail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Number of times a task may be retried when its guardrail rejects the output.</rdfs:comment>
        <rdfs:label>has max retries</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasMaxTurns -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasMaxTurns">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#TurnLimitTermination"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Maximum number of conversational turns after which execution terminates.</rdfs:comment>
        <rdfs:label>has max turns</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasMemoryScope -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasMemoryScope">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#MemoryBinding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Visibility of a memory binding. Values: &quot;AgentPrivate&quot; (memory owned by a single agent) and &quot;GroupShared&quot; (memory shared across a team).</rdfs:comment>
        <rdfs:label>has memory scope</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasOperator -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasOperator">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#CompositeTermination"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Logical operator combining the sub-conditions of a composite termination condition. Values: &quot;OR&quot;, &quot;AND&quot;.</rdfs:comment>
        <rdfs:label>has operator</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasPersistenceScope -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasPersistenceScope">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Memory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Lifetime of a memory. Values: &quot;ExecutionScoped&quot; (discarded after the run) and &quot;Persistent&quot; (retained across runs).</rdfs:comment>
        <rdfs:label>has persistence scope</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasReasoningEnabled -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasReasoningEnabled">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether explicit reasoning is enabled for an agent.</rdfs:comment>
        <rdfs:label>has reasoning enabled</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasReasoningOrigin -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasReasoningOrigin">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#LLMAgent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Where an agent&apos;s reasoning capability comes from. Values: &quot;FrameworkManaged&quot; (the framework adds a reasoning loop) and &quot;ModelNative&quot; (the underlying model reasons on its own).</rdfs:comment>
        <rdfs:label>has reasoning origin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasRoutingLogic -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasRoutingLogic">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#ConditionalStep"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Serialized body of the routing function that decides which branch a conditional step takes.</rdfs:comment>
        <rdfs:label>has routing logic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasSchemaDefinition -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasSchemaDefinition">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#Schema"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Serialized definition of a structured-output schema, expressed as JSON Schema.</rdfs:comment>
        <rdfs:label>has schema definition</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasSourceAttribute -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasSourceAttribute">
        <rdfs:domain rdf:resource="http://www.w3id.org/agentic-ai/onto#Prompt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Framework attribute(s) the annotated element was derived from (e.g. &quot;role, goal, backstory&quot;, &quot;system_message&quot;, &quot;output_pydantic&quot;). Enables faithful regeneration of source code from the ontology.</rdfs:comment>
        <rdfs:label>has source attribute</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasSourceFramework -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasSourceFramework">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#AgenticSystem"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Framework the agentic system was extracted from (e.g. &quot;CrewAI&quot;, &quot;AutoGen&quot;, &quot;LangGraph&quot;).</rdfs:comment>
        <rdfs:label>has source framework</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasTriggerExpression -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasTriggerExpression">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#EventBasedTermination"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Expression or text whose occurrence triggers an event-based termination condition (e.g. a stop keyword in an agent message).</rdfs:comment>
        <rdfs:label>has trigger expression</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#hasValidationLogic -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#hasValidationLogic">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#Guardrail"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Validation performed by a guardrail: the name of the validation function, or the validation prompt for LLM-based guardrails.</rdfs:comment>
        <rdfs:label>has validation logic</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/agentoscin/onto#isMandatory -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/agentoscin/onto#isMandatory">
        <rdfs:domain rdf:resource="https://w3id.org/agentoscin/onto#HumanCheckpoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Whether the human checkpoint must be passed, i.e. execution cannot continue without human input.</rdfs:comment>
        <rdfs:label>is mandatory</rdfs:label>
    </owl:DatatypeProperty>
    


