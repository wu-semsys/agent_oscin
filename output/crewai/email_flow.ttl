@prefix agento: <http://www.w3id.org/agentic-ai/onto#> .
@prefix agentoscin: <https://w3id.org/agentoscin/onto#> .
@prefix beam: <http://w3id.org/beam/core#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <http://example.org/email_flow#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/email_flow> a owl:Ontology ;
    owl:imports <http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> .

ex:EmailFlowSystem a agentoscin:AgenticSystem ;
    agentoscin:containsAgent ex:Agent_email_action_agent,
        ex:Agent_email_filter_agent,
        ex:Agent_email_response_writer ;
    agentoscin:containsOrchestration ex:Orchestration_EmailAutoResponderFlow ;
    agentoscin:containsTeam ex:Team_EmailFilterCrew ;
    agentoscin:hasSourceFramework "CrewAI"^^xsd:string ;
    agentoscin:hasTitle "EmailFlowSystem"^^xsd:string .

dcterms:license a owl:AnnotationProperty .

agentoscin:ChainOfThought a owl:Class ;
    rdfs:label "Chain of Thought" ;
    rdfs:comment "Reasoning pattern in which an agent produces explicit intermediate reasoning steps before answering." ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Custom a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Custom" ;
    rdfs:comment "Coordination pattern that does not match any of the predefined patterns, e.g. a framework-specific or hand-written control flow." .

agentoscin:Hierarchical a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Hierarchical" ;
    rdfs:comment "Coordination pattern in which a manager agent delegates work to subordinate agents and integrates their results." .

agentoscin:Network a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Network" ;
    rdfs:comment "Coordination pattern in which agents communicate peer-to-peer along a graph of connections without a central coordinator." .

agentoscin:ReAct a owl:Class ;
    rdfs:label "ReAct" ;
    rdfs:comment "Reasoning pattern interleaving reasoning steps with tool calls and observations (Reason + Act)." ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:ReActLoop a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "ReAct Loop" ;
    rdfs:comment "Coordination pattern in which a single agent cycles between reasoning and tool execution until it produces a final answer." .

agentoscin:ReflectionLoop a owl:Class ;
    rdfs:label "Reflection Loop" ;
    rdfs:comment "Reasoning pattern in which an agent iteratively critiques and revises its own output." ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:RoundRobin a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Round Robin" ;
    rdfs:comment "Coordination pattern in which agents take turns in a fixed cyclic order." .

agentoscin:SelectorBased a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Selector Based" ;
    rdfs:comment "Coordination pattern in which a selector — typically a model — chooses which agent speaks next at each turn." .

agentoscin:Swarm a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Swarm" ;
    rdfs:comment "Coordination pattern in which agents hand off control to one another dynamically, based on which agent is best suited to continue." .

agentoscin:TreeOfThoughts a owl:Class ;
    rdfs:label "Tree of Thoughts" ;
    rdfs:comment "Reasoning pattern that explores several alternative reasoning branches and selects among them." ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:Unspecified a owl:Class ;
    rdfs:label "Unspecified" ;
    rdfs:comment "Placeholder reasoning pattern used when the source system does not state which reasoning strategy an agent follows." ;
    rdfs:subClassOf agentoscin:ReasoningPattern .

agentoscin:agentType a owl:DatatypeProperty ;
    rdfs:label "agent type" ;
    rdfs:comment "Framework-specific classification of an agent's role in the system. Values: \"GeneralPurpose\", \"UserProxy\", \"Manager\"." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

agentoscin:bindsMemory a owl:ObjectProperty ;
    rdfs:label "binds memory" ;
    rdfs:comment "Links a memory binding to the memory it binds." ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range agento:Memory .

agentoscin:callsCrew a owl:DatatypeProperty ;
    rdfs:label "calls crew" ;
    rdfs:comment "Key of the team/crew invoked by this workflow step (e.g. CrewAI @listen method calling crew.kickoff()). Enables per-step crew binding through the ontology round-trip." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

agentoscin:containsAgent a owl:ObjectProperty ;
    rdfs:label "contains agent" ;
    rdfs:comment "Relates an agentic system to an agent it contains." ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agento:LLMAgent .

agentoscin:containsOrchestration a owl:ObjectProperty ;
    rdfs:label "contains orchestration" ;
    rdfs:comment "Relates an agentic system to its orchestration." ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agentoscin:Orchestration .

agentoscin:containsTeam a owl:ObjectProperty ;
    rdfs:label "contains team" ;
    rdfs:comment "Relates an agentic system to a team it contains." ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range agento:Team .

agentoscin:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "Indicates that one task depends on another." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Task .

agentoscin:employsCoordinationPattern a owl:ObjectProperty ;
    rdfs:label "employs coordination pattern" ;
    rdfs:comment "Relates a team to the coordination pattern it employs." ;
    rdfs:domain agento:Team ;
    rdfs:range agentoscin:CoordinationPattern .

agentoscin:employsReasoningPattern a owl:ObjectProperty ;
    rdfs:label "employs reasoning pattern" ;
    rdfs:comment "Relates an agent to the reasoning pattern it employs." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agentoscin:ReasoningPattern .

agentoscin:hasAgentMemoryBinding a owl:ObjectProperty ;
    rdfs:label "has agent memory binding" ;
    rdfs:comment "Memory binding attached to an individual agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf agentoscin:hasMemoryBinding .

agentoscin:hasAggregationCombinator a owl:DatatypeProperty ;
    rdfs:label "has aggregation combinator" ;
    rdfs:comment "Combinator used to aggregate multiple predecessor steps in the source decorator (e.g. CrewAI @listen(or_(step_a, step_b)) stores \"or_\"). Values: \"or_\", \"and_\", or empty for single-predecessor steps." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

agentoscin:hasAssociatedAgent a owl:ObjectProperty ;
    rdfs:label "has associated agent" ;
    rdfs:comment "Links a workflow step to the agent that executes it (e.g. a LangGraph node function implemented by a specific LLMAgent)." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range agento:LLMAgent .

agentoscin:hasCheckpointPosition a owl:DatatypeProperty ;
    rdfs:label "has checkpoint position" ;
    rdfs:comment "Point in the execution of a task at which the human checkpoint is applied (e.g. \"AfterExecution\")." ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string .

agentoscin:hasCheckpointType a owl:DatatypeProperty ;
    rdfs:label "has checkpoint type" ;
    rdfs:comment "Kind of human interaction requested at a checkpoint. Values: \"Approval\", \"Review\", \"InputRequest\"." ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:string .

agentoscin:hasDecoratorArgument a owl:DatatypeProperty ;
    rdfs:label "has decorator argument" ;
    rdfs:comment "Original literal argument(s) of the framework decorator that defined this step (e.g. CrewAI @start(\"wait_next_run\") or @listen(\"label\")). Preserves source-level identifiers that are not method names and therefore cannot be reconstructed from the inverse of nextStep edges." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

agentoscin:hasDelegationStrategy a owl:DatatypeProperty ;
    rdfs:label "has delegation strategy" ;
    rdfs:comment "Strategy by which a task may be handed over to another agent instead of being executed by its assigned agent." ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

agentoscin:hasDependencyType a owl:DatatypeProperty ;
    rdfs:label "has dependency type" ;
    rdfs:comment "Nature of the dependency between two tasks. Values: \"Sequential\" (ordering imposed by the workflow) and \"ContextProviding\" (the predecessor supplies context to the successor)." ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

agentoscin:hasDirectiveFunction a owl:DatatypeProperty ;
    rdfs:label "has directive function" ;
    rdfs:comment "Role that a prompt plays for its agent. Values: \"ModelDirective\" (instructs the underlying model), \"OrchestratorDirective\" (describes the agent to a coordinating agent), \"DualDirective\" (serves both purposes)." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agentoscin:hasEdgeMapping a owl:DatatypeProperty ;
    rdfs:label "has edge mapping" ;
    rdfs:comment "JSON object mapping the return labels of a conditional step to the names of the target steps (e.g. LangGraph add_conditional_edges path map). Preserves branch targets that cannot be reconstructed from nextStep edges alone." ;
    rdfs:domain agento:WorkflowStep ;
    rdfs:range xsd:string .

agentoscin:hasExpectedOutput a owl:DatatypeProperty ;
    rdfs:label "has expected output" ;
    rdfs:comment "Natural-language description of the output a task is expected to produce." ;
    rdfs:domain agento:Task ;
    rdfs:range xsd:string .

agentoscin:hasGuardrail a owl:ObjectProperty ;
    rdfs:label "has guardrail" ;
    rdfs:comment "Associates a guardrail with a task." ;
    rdfs:domain agento:Task ;
    rdfs:range agentoscin:Guardrail .

agentoscin:hasGuardrailType a owl:DatatypeProperty ;
    rdfs:label "has guardrail type" ;
    rdfs:comment "How a guardrail is implemented. Values: \"FunctionBased\" (a validation callable) and \"LLMBased\" (a natural-language validation prompt)." ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string .

agentoscin:hasHumanCheckpoint a owl:ObjectProperty ;
    rdfs:label "has human checkpoint" ;
    rdfs:comment "Associates a human-in-the-loop checkpoint with a task." ;
    rdfs:domain agento:Task ;
    rdfs:range agentoscin:HumanCheckpoint .

agentoscin:hasImplementationReference a owl:DatatypeProperty ;
    rdfs:label "has implementation reference" ;
    rdfs:comment "Reference to the implementation of a tool, typically a module path or an \"external:<name>\" marker for imported tools that were not found in the parsed sources." ;
    rdfs:domain agento:Tool ;
    rdfs:range xsd:string .

agentoscin:hasInputSchema a owl:DatatypeProperty ;
    rdfs:label "has input schema" ;
    rdfs:comment "Serialized JSON Schema describing the arguments accepted by a tool." ;
    rdfs:domain agento:Tool ;
    rdfs:range xsd:string .

agentoscin:hasMaxReasoningAttempts a owl:DatatypeProperty ;
    rdfs:label "has max reasoning attempts" ;
    rdfs:comment "Upper bound on the number of reasoning attempts an agent may perform before giving up." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:integer .

agentoscin:hasMaxRetries a owl:DatatypeProperty ;
    rdfs:label "has max retries" ;
    rdfs:comment "Number of times a task may be retried when its guardrail rejects the output." ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:integer .

agentoscin:hasMaxTurns a owl:DatatypeProperty ;
    rdfs:label "has max turns" ;
    rdfs:comment "Maximum number of conversational turns after which execution terminates." ;
    rdfs:domain agentoscin:TurnLimitTermination ;
    rdfs:range xsd:integer .

agentoscin:hasMemoryScope a owl:DatatypeProperty ;
    rdfs:label "has memory scope" ;
    rdfs:comment "Visibility of a memory binding. Values: \"AgentPrivate\" (memory owned by a single agent) and \"GroupShared\" (memory shared across a team)." ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range xsd:string .

agentoscin:hasOperator a owl:DatatypeProperty ;
    rdfs:label "has operator" ;
    rdfs:comment "Logical operator combining the sub-conditions of a composite termination condition. Values: \"OR\", \"AND\"." ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range xsd:string .

agentoscin:hasOutputSchema a owl:ObjectProperty ;
    rdfs:label "has output schema" ;
    rdfs:comment "Specifies the schema of the structured output produced by an orchestration or task." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( agentoscin:Orchestration agento:Task ) ] ;
    rdfs:range agentoscin:Schema .

agentoscin:hasPersistenceScope a owl:DatatypeProperty ;
    rdfs:label "has persistence scope" ;
    rdfs:comment "Lifetime of a memory. Values: \"ExecutionScoped\" (discarded after the run) and \"Persistent\" (retained across runs)." ;
    rdfs:domain agento:Memory ;
    rdfs:range xsd:string .

agentoscin:hasReasoningEnabled a owl:DatatypeProperty ;
    rdfs:label "has reasoning enabled" ;
    rdfs:comment "Whether explicit reasoning is enabled for an agent." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:boolean .

agentoscin:hasReasoningOrigin a owl:DatatypeProperty ;
    rdfs:label "has reasoning origin" ;
    rdfs:comment "Where an agent's reasoning capability comes from. Values: \"FrameworkManaged\" (the framework adds a reasoning loop) and \"ModelNative\" (the underlying model reasons on its own)." ;
    rdfs:domain agento:LLMAgent ;
    rdfs:range xsd:string .

agentoscin:hasRoutingLogic a owl:DatatypeProperty ;
    rdfs:label "has routing logic" ;
    rdfs:comment "Serialized body of the routing function that decides which branch a conditional step takes." ;
    rdfs:domain agentoscin:ConditionalStep ;
    rdfs:range xsd:string .

agentoscin:hasSchemaDefinition a owl:DatatypeProperty ;
    rdfs:label "has schema definition" ;
    rdfs:comment "Serialized definition of a structured-output schema, expressed as JSON Schema." ;
    rdfs:domain agentoscin:Schema ;
    rdfs:range xsd:string .

agentoscin:hasSourceAttribute a owl:DatatypeProperty ;
    rdfs:label "has source attribute" ;
    rdfs:comment "Framework attribute(s) the annotated element was derived from (e.g. \"role, goal, backstory\", \"system_message\", \"output_pydantic\"). Enables faithful regeneration of source code from the ontology." ;
    rdfs:domain agento:Prompt ;
    rdfs:range xsd:string .

agentoscin:hasSourceFramework a owl:DatatypeProperty ;
    rdfs:label "has source framework" ;
    rdfs:comment "Framework the agentic system was extracted from (e.g. \"CrewAI\", \"AutoGen\", \"LangGraph\")." ;
    rdfs:domain agentoscin:AgenticSystem ;
    rdfs:range xsd:string .

agentoscin:hasSubCondition a owl:ObjectProperty ;
    rdfs:label "has sub condition" ;
    rdfs:comment "A sub-condition combined within a composite termination condition." ;
    rdfs:domain agentoscin:CompositeTermination ;
    rdfs:range agentoscin:TerminationCondition .

agentoscin:hasTeamMemoryBinding a owl:ObjectProperty ;
    rdfs:label "has team memory binding" ;
    rdfs:comment "Memory binding attached to a team." ;
    rdfs:domain agento:Team ;
    rdfs:range agentoscin:MemoryBinding ;
    rdfs:subPropertyOf agentoscin:hasMemoryBinding .

agentoscin:hasTerminationCondition a owl:ObjectProperty ;
    rdfs:label "has termination condition" ;
    rdfs:comment "Relates a team to a termination condition that ends its execution." ;
    rdfs:domain agento:Team ;
    rdfs:range agentoscin:TerminationCondition .

agentoscin:hasTriggerExpression a owl:DatatypeProperty ;
    rdfs:label "has trigger expression" ;
    rdfs:comment "Expression or text whose occurrence triggers an event-based termination condition (e.g. a stop keyword in an agent message)." ;
    rdfs:domain agentoscin:EventBasedTermination ;
    rdfs:range xsd:string .

agentoscin:hasValidationLogic a owl:DatatypeProperty ;
    rdfs:label "has validation logic" ;
    rdfs:comment "Validation performed by a guardrail: the name of the validation function, or the validation prompt for LLM-based guardrails." ;
    rdfs:domain agentoscin:Guardrail ;
    rdfs:range xsd:string .

agentoscin:isMandatory a owl:DatatypeProperty ;
    rdfs:label "is mandatory" ;
    rdfs:comment "Whether the human checkpoint must be passed, i.e. execution cannot continue without human input." ;
    rdfs:domain agentoscin:HumanCheckpoint ;
    rdfs:range xsd:boolean .

agentoscin:memoryBoundTo a owl:ObjectProperty ;
    rdfs:label "memory bound to" ;
    rdfs:comment "Links a memory binding to the agent, team, or system that owns it." ;
    rdfs:domain agentoscin:MemoryBinding ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( agentoscin:AgenticSystem agento:LLMAgent agento:Team ) ] .

agentoscin:orchestratesTeam a owl:ObjectProperty ;
    rdfs:label "orchestrates team" ;
    rdfs:comment "Relates an orchestration to the team it orchestrates." ;
    rdfs:domain agentoscin:Orchestration ;
    rdfs:range agento:Team .

agentoscin:taskToolUsage a owl:ObjectProperty ;
    rdfs:label "task tool usage" ;
    rdfs:comment "A tool used in the execution of a task." ;
    rdfs:domain agento:Task ;
    rdfs:range agento:Tool ;
    rdfs:subPropertyOf agento:toolUsage .

ex:AgentPrompt_email_action_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptContext "As a seasoned executive assistant, you excel at understanding the context of business communications and determining the appropriate response and actions required for each email."^^xsd:string ;
    agento:promptInstruction "Email Action Specialist: For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:AgentPrompt_email_filter_agent a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptContext "With years of experience in email management and communication triage, you are adept at quickly identifying important emails that require immediate action from those that can be archived or ignored."^^xsd:string ;
    agento:promptInstruction "Senior Email Analyst: Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:AgentPrompt_email_response_writer a agento:Prompt ;
    agentoscin:hasDirectiveFunction "DualDirective"^^xsd:string ;
    agentoscin:hasSourceAttribute "role, goal, backstory"^^xsd:string ;
    agento:promptContext "You are a skilled communicator with a talent for crafting clear, professional, and context-appropriate email responses. You understand the nuances of business communication and can adapt your tone and style to match the situation."^^xsd:string ;
    agento:promptInstruction "Email Response Writer: Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:Config_allow_delegation_Agent_email_filter_agent a agento:Config ;
    agento:configKey "allow_delegation"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_action_agent a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_filter_agent a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ex:Config_verbose_Agent_email_response_writer a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ex:Config_verbose_Team_EmailFilterCrew a agento:Config ;
    agento:configKey "verbose"^^xsd:string ;
    agento:configValue "true"^^xsd:string .

ex:CrewStep_EmailFilterCrew_filter_emails_task a agento:StartStep ;
    agentoscin:hasTitle "filter_emails_task"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_filter_emails_task ;
    agento:nextStep ex:CrewStep_EmailFilterCrew_action_required_emails_task ;
    agento:stepOrder 1 .

ex:FlowStep_fetch_new_emails a agento:StartStep,
        agento:WorkflowStep ;
    agentoscin:hasDecoratorArgument "wait_next_run"^^xsd:string ;
    agentoscin:hasTitle "fetch_new_emails"^^xsd:string ;
    agento:nextStep ex:FlowStep_generate_draft_responses ;
    agento:stepOrder 1 .

ex:FlowWorkflowPattern_EmailAutoResponderFlow a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:FlowStep_fetch_new_emails,
        ex:FlowStep_generate_draft_responses .

ex:Goal_email_action_agent a agento:Goal ;
    agentoscin:hasDescription "For each email identified as action-required, determine the necessary steps and provide a brief summary of the required actions."^^xsd:string .

ex:Goal_email_filter_agent a agento:Goal ;
    agentoscin:hasDescription "Filter out non-essential emails like newsletters and promotional content, and identify important action-required emails that need immediate attention."^^xsd:string .

ex:Goal_email_response_writer a agento:Goal ;
    agentoscin:hasDescription "Draft professional and appropriate responses to action-required emails based on the determined actions and context."^^xsd:string .

ex:Orchestration_EmailAutoResponderFlow a agentoscin:Orchestration ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasOutputSchema ex:StateSchema_EmailAutoResponderFlow ;
    agentoscin:hasTitle "EmailAutoResponderFlow"^^xsd:string ;
    agentoscin:orchestratesTeam ex:Team_EmailFilterCrew ;
    agento:hasWorkflowPattern ex:FlowWorkflowPattern_EmailAutoResponderFlow .

ex:StateSchema_EmailAutoResponderFlow a agentoscin:Schema ;
    agentoscin:hasSchemaDefinition "{\"checked_emails_ids\": \"set[str]\", \"emails\": \"List[Email]\"}"^^xsd:string ;
    agentoscin:hasSourceAttribute "state_model"^^xsd:string ;
    agentoscin:hasTitle "AutoResponderState"^^xsd:string .

ex:TaskPrompt_action_required_emails_task a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "For each email classified as 'action_required', analyze the content and determine the specific actions that need to be taken. Consider the urgency, context, and any deadlines mentioned in the emails."^^xsd:string ;
    agento:promptOutputIndicator "A detailed action plan for each action-required email, including the specific steps to take, priority level, and any relevant deadlines."^^xsd:string .

ex:TaskPrompt_draft_responses_task a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction "Based on the action plans provided, draft professional email responses for each action-required email. Ensure the responses are clear, concise, and appropriate for the context."^^xsd:string ;
    agento:promptOutputIndicator "A set of draft email responses ready to be reviewed and sent, each properly formatted with subject line, greeting, body, and closing."^^xsd:string .

ex:TaskPrompt_filter_emails_task a agento:Prompt ;
    agentoscin:hasSourceAttribute "description, expected_output"^^xsd:string ;
    agento:promptInstruction """Analyze the list of emails provided and categorize each email as either 'action_required' or 'no_action_needed'. Use your expertise to filter out newsletters, promotional content, and spam.
Here are the emails: {emails}"""^^xsd:string ;
    agento:promptOutputIndicator "A categorized list of emails with their classification as either 'action_required' or 'no_action_needed', along with a brief reason for each classification."^^xsd:string .

ex:Task_draft_responses_task a agento:Task ;
    agentoscin:dependsOn ex:Task_action_required_emails_task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "A set of draft email responses ready to be reviewed and sent, each properly formatted with subject line, greeting, body, and closing."^^xsd:string ;
    agento:performedByAgent ex:Agent_email_response_writer ;
    agento:taskPrompt ex:TaskPrompt_draft_responses_task .

ex:Tool_SerperDevTool a agento:Tool ;
    agentoscin:hasReference "external:SerperDevTool"^^xsd:string ;
    agentoscin:hasTitle "SerperDevTool"^^xsd:string .

ex:Tool_create_draft a agento:Tool ;
    agentoscin:hasDescription """Useful to create an email draft.
The input to this tool should be a pipe (|) separated text
of length 3 (three), representing who to send the email to,
the subject of the email and the actual message.
For example, `lorem@ipsum.com|Nice To Meet You|Hey it was great to meet you.`."""^^xsd:string ;
    agentoscin:hasImplementationReference "tools.create_draft.create_draft"^^xsd:string ;
    agentoscin:hasInputSchema "{}"^^xsd:string ;
    agentoscin:hasTitle "Create Draft"^^xsd:string .

ex:WorkflowPattern_EmailFilterCrew a agento:WorkflowPattern ;
    agento:hasWorkflowStep ex:CrewStep_EmailFilterCrew_action_required_emails_task,
        ex:CrewStep_EmailFilterCrew_draft_responses_task,
        ex:CrewStep_EmailFilterCrew_filter_emails_task .

<http://www.semanticweb.org/danilippmann/ontologies/2026/3/agentoscin> a owl:Ontology ;
    rdfs:label "AgentOSCIN Ontology" ;
    dc:creator "Dani Lippmann" ;
    dc:description "Extension of agentO adding agentic-system orchestration, coordination & reasoning patterns, memory bindings, guardrails, human checkpoints, termination conditions, schemas, and framework-mapping properties."@en ;
    dc:title "AgentOSCIn — Extension of the Agentic AI Ontology" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:imports <http://www.w3id.org/agentic-ai/onto> .

agentoscin:ConditionalStep a owl:Class ;
    rdfs:label "Conditional Step" ;
    rdfs:comment "A workflow step that branches based on routing logic." ;
    rdfs:subClassOf agento:WorkflowStep .

agentoscin:RoutingTermination a owl:Class ;
    rdfs:label "Routing Termination" ;
    rdfs:comment "Termination condition under which execution ends because the routing logic reaches a terminal branch." ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:TaskCompletionTermination a owl:Class ;
    rdfs:label "Task Completion Termination" ;
    rdfs:comment "Termination condition satisfied when the assigned task is completed." ;
    rdfs:subClassOf agentoscin:TerminationCondition .

ex:CrewStep_EmailFilterCrew_action_required_emails_task a agento:WorkflowStep ;
    agentoscin:hasTitle "action_required_emails_task"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_action_required_emails_task ;
    agento:nextStep ex:CrewStep_EmailFilterCrew_draft_responses_task ;
    agento:stepOrder 2 .

ex:CrewStep_EmailFilterCrew_draft_responses_task a agento:EndStep ;
    agentoscin:hasTitle "draft_responses_task"^^xsd:string ;
    agento:hasAssociatedTask ex:Task_draft_responses_task ;
    agento:stepOrder 3 .

ex:FlowStep_generate_draft_responses a agento:EndStep,
        agento:WorkflowStep ;
    agentoscin:callsCrew "EmailFilterCrew"^^xsd:string ;
    agentoscin:hasTitle "generate_draft_responses"^^xsd:string ;
    agento:stepOrder 2 .

ex:Task_action_required_emails_task a agento:Task ;
    agentoscin:dependsOn ex:Task_filter_emails_task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasDependencyType "Sequential"^^xsd:string ;
    agentoscin:hasExpectedOutput "A detailed action plan for each action-required email, including the specific steps to take, priority level, and any relevant deadlines."^^xsd:string ;
    agento:performedByAgent ex:Agent_email_action_agent ;
    agento:taskPrompt ex:TaskPrompt_action_required_emails_task .

ex:Task_filter_emails_task a agento:Task ;
    agentoscin:hasDelegationStrategy "ExplicitAssignment"^^xsd:string ;
    agentoscin:hasExpectedOutput "A categorized list of emails with their classification as either 'action_required' or 'no_action_needed', along with a brief reason for each classification."^^xsd:string ;
    agento:performedByAgent ex:Agent_email_filter_agent ;
    agento:taskPrompt ex:TaskPrompt_filter_emails_task .

ex:Team_EmailFilterCrew a agento:Team ;
    agentoscin:employsCoordinationPattern agentoscin:Sequential ;
    agentoscin:hasTitle "EmailFilterCrew"^^xsd:string ;
    agento:hasAgentMember ex:Agent_email_action_agent,
        ex:Agent_email_filter_agent,
        ex:Agent_email_response_writer ;
    agento:hasSystemConfig ex:Config_verbose_Team_EmailFilterCrew ;
    agento:hasWorkflowPattern ex:WorkflowPattern_EmailFilterCrew .

ex:Tool_GmailGetThread a agento:Tool ;
    agentoscin:hasReference "external:GmailGetThread"^^xsd:string ;
    agentoscin:hasTitle "GmailGetThread"^^xsd:string .

ex:Tool_TavilySearchResults a agento:Tool ;
    agentoscin:hasReference "external:TavilySearchResults"^^xsd:string ;
    agentoscin:hasTitle "TavilySearchResults"^^xsd:string .

agentoscin:EventBasedTermination a owl:Class ;
    rdfs:label "Event Based Termination" ;
    rdfs:comment "Termination condition that fires when a designated event occurs, e.g. a stop expression appearing in an agent message." ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Sequential a agentoscin:CoordinationPattern,
        owl:NamedIndividual ;
    rdfs:label "Sequential" ;
    rdfs:comment "Coordination pattern in which agents act one after another in a fixed order, each consuming the previous output." .

agentoscin:TurnLimitTermination a owl:Class ;
    rdfs:label "Turn Limit Termination" ;
    rdfs:comment "Termination condition that ends execution once a maximum number of turns is reached." ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:hasMemoryBinding a owl:ObjectProperty ;
    rdfs:label "has memory binding" ;
    rdfs:comment "Associates a subject (agent, team, system) with a memory binding." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( agentoscin:AgenticSystem agento:LLMAgent agento:Team ) ] ;
    rdfs:range agentoscin:MemoryBinding .

ex:Agent_email_action_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "email_action_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_email_action_agent ;
    agento:agentRole "Email Action Specialist"^^xsd:string ;
    agento:agentToolUsage ex:Tool_GmailGetThread,
        ex:Tool_TavilySearchResults ;
    agento:hasAgentConfig ex:Config_verbose_Agent_email_action_agent ;
    agento:hasAgentGoal ex:Goal_email_action_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Agent_email_filter_agent a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "email_filter_agent"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_email_filter_agent ;
    agento:agentRole "Senior Email Analyst"^^xsd:string ;
    agento:agentToolUsage ex:Tool_SerperDevTool ;
    agento:hasAgentConfig ex:Config_allow_delegation_Agent_email_filter_agent,
        ex:Config_verbose_Agent_email_filter_agent ;
    agento:hasAgentGoal ex:Goal_email_filter_agent ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:Agent_email_response_writer a agento:LLMAgent ;
    agentoscin:agentType "GeneralPurpose"^^xsd:string ;
    agentoscin:hasReasoningEnabled false ;
    agento:agentID "email_response_writer"^^xsd:string ;
    agento:agentPrompt ex:AgentPrompt_email_response_writer ;
    agento:agentRole "Email Response Writer"^^xsd:string ;
    agento:agentToolUsage ex:Tool_GmailGetThread,
        ex:Tool_TavilySearchResults,
        ex:Tool_create_draft ;
    agento:hasAgentConfig ex:Config_verbose_Agent_email_response_writer ;
    agento:hasAgentGoal ex:Goal_email_response_writer ;
    agento:useLanguageModel ex:LM_gpt_4o .

ex:LM_gpt_4o a agento:LanguageModel ;
    agentoscin:hasTitle "gpt-4o"^^xsd:string .

agentoscin:CompositeTermination a owl:Class ;
    rdfs:label "Composite Termination" ;
    rdfs:comment "A termination condition built by combining other conditions via a logical operator." ;
    rdfs:subClassOf agentoscin:TerminationCondition .

agentoscin:Schema a owl:Class ;
    rdfs:label "Schema" ;
    rdfs:comment "A structured-output schema (e.g. JSON Schema, Pydantic model)." .

agentoscin:Guardrail a owl:Class ;
    rdfs:label "Guardrail" ;
    rdfs:comment "A validation, safety, or policy check applied to a task." .

agentoscin:HumanCheckpoint a owl:Class ;
    rdfs:label "Human Checkpoint" ;
    rdfs:comment "A human-in-the-loop checkpoint inserted into task execution." .

agentoscin:Orchestration a owl:Class ;
    rdfs:label "Orchestration" ;
    rdfs:comment "A controller that orchestrates one or more teams to execute a workflow." ;
    rdfs:subClassOf agento:Team .

agentoscin:MemoryBinding a owl:Class ;
    rdfs:label "Memory Binding" ;
    rdfs:comment "A reified link between a memory and the agent, team, or system that uses it, with scope and configuration." .

agentoscin:ReasoningPattern a owl:Class ;
    rdfs:label "Reasoning Pattern" ;
    rdfs:comment "A reasoning strategy adopted by an agent (e.g. chain-of-thought, ReAct, tree-of-thoughts)." .

agentoscin:AgenticSystem a owl:Class ;
    rdfs:label "Agentic System" ;
    rdfs:comment "A complete agentic AI system encompassing one or more agents, teams, and an orchestration." ;
    rdfs:subClassOf beam:System .

agentoscin:TerminationCondition a owl:Class ;
    rdfs:label "Termination Condition" ;
    rdfs:comment "A condition under which a team's execution terminates." .

agentoscin:CoordinationPattern a owl:Class ;
    rdfs:label "Coordination Pattern" ;
    rdfs:comment "A pattern of coordination among agents in a team (e.g. sequential, hierarchical, swarm)." .

[] a owl:AllDisjointClasses ;
    owl:members ( agentoscin:CompositeTermination agentoscin:EventBasedTermination agentoscin:RoutingTermination agentoscin:TaskCompletionTermination agentoscin:TurnLimitTermination ) .

